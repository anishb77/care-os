# Copy this file to .env and fill in real values.
# Get these from Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=https://yourproject.supabase.co

# SERVICE ROLE key -- NOT the anon key. This bypasses Row Level Security,
# so it must only ever live here (backend) or in Render's env var settings.
# NEVER put this in the Next.js frontend or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
